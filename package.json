{
  "name": "quiplash-clone",
  "version": "1.0.0",
  "description": "Quipsmash \u2014 a Quiplash-style party game for SAP town halls: teams, host moderation, 100+ players.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/simulate.js 4",
    "test:chaos": "node test/stress.js",
    "test:browser": "node test/dom-check.js",
    "test:layout": "node test/layout.js 8",
    "test:shots": "node test/visual.js",
    "test:all": "./test/all.sh",
    "test:reconnect": "node test/reconnect.js",
    "test:prompts": "node test/prompts.js",
    "test:lobby": "node test/lobby.js",
    "test:teams": "node test/teams.js 100 5",
    "test:townhall": "node test/townhall.js",
    "test:moderation": "node test/moderation.js",
    "test:host": "node test/hostcontrols.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.0"
  }
}
